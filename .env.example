# Copy to .env (never commit .env)

# Git push (push.ps1)
GITHUB_TOKEN=ghp_your_token_here

# Live job aggregator — free signup: https://developer.adzuna.com/signup
ADZUNA_APP_ID=your_app_id
ADZUNA_API_KEY=your_app_key

# Optional federal jobs — https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com

# Fetch tuning
LIVE_MAX_DAYS=14
LIVE_MAX_JOBS=150
LIVE_SEARCH_LOCATION=Salem, OR
